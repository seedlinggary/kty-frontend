// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Holiday {
  id                    String     @id @default(cuid())
  slug                  String     @unique
  nameEn                String
  nameHe                String
  descriptionEn         String?
  descriptionHe         String?
  memberPriceAgorot     Int
  nonMemberPriceAgorot  Int
  isOpen                Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  signups               Signup[]
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}

/// One payment: contact info + membership status + amount + NedarimPlus reference.
/// Can cover seats for more than one holiday at once via its line items (Signup).
model Bill {
  id            String        @id @default(cuid())
  referenceCode String        @unique
  fullName      String
  phone         String
  email         String?
  isMember      Boolean
  notes         String?
  totalAgorot   Int
  status        BillStatus    @default(PENDING)
  createdBy     String        @default("public")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lineItems     Signup[]
  transactions  Transaction[]

  @@index([status])
}

/// One line item within a Bill: seats for a single holiday.
model Signup {
  id          String   @id @default(cuid())
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      String
  holiday     Holiday  @relation(fields: [holidayId], references: [id], onDelete: Restrict)
  holidayId   String
  menSeats    Int      @default(0)
  womenSeats  Int      @default(0)
  totalAgorot Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([billId, holidayId])
  @@index([holidayId])
}

model Transaction {
  id                    String   @id @default(cuid())
  bill                  Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId                String
  nedarimTransactionId  String?
  confirmation          String?
  amountAgorot          Int
  source                String   @default("webhook")
  rawPayload            Json?
  receivedAt            DateTime @default(now())

  @@index([billId])
}

model SiteSettings {
  id              Int    @id @default(1)
  aboutEn         String
  aboutHe         String
  contactPhone    String
  contactEmail    String
  address         String
  serviceTimesEn  String?
  serviceTimesHe  String?
  heroTaglineEn   String
  heroTaglineHe   String
}
