// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  /// SUPERADMIN can overwrite payment records (amount/status/contact info) directly
  /// from the admin UI; plain ADMIN can view, send follow-up emails, and the normal
  /// mark-paid/cancel actions, but not freehand-edit a payment's recorded details.
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

/// A real individual (a congregant/payer - not an admin login, see Admin),
/// who may have signed up / paid multiple separate times (NedarimPlus itself
/// never de-duplicates - every signup becomes its own unrelated record
/// there). Staff explicitly merge Bills/Donations/Memberships/PaymentLinks
/// onto one User from /admin/search, so the same person's whole history
/// shows as one combined view instead of scattered unrelated entries.
/// Nothing is ever required to have a User - records stay fully usable
/// unlinked, and deleting a User only unlinks its records (never deletes
/// them - see onDelete: SetNull below).
model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  address   String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills                Bill[]
  donations            Donation[]
  memberships          Membership[]
  paymentLinks         PaymentLink[]
  formResponses        FormResponse[]
  externalTransactions ExternalTransaction[]

  @@index([email])
}

model Holiday {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  nameEn               String
  nameHe               String
  descriptionEn        String?
  descriptionHe        String?
  memberPriceAgorot    Int
  nonMemberPriceAgorot Int
  isOpen               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  signups              Signup[]
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}

/// One payment: contact info + membership status + amount + NedarimPlus reference.
/// Can cover seats for more than one holiday at once via its line items (Signup).
model Bill {
  id            String            @id @default(cuid())
  referenceCode String            @unique
  fullName      String
  phone         String
  email         String?
  isMember      Boolean
  notes         String?
  totalAgorot   Int
  status        BillStatus        @default(PENDING)
  createdBy     String            @default("public")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lineItems     Signup[]
  transactions  Transaction[]
  followUps     PaymentFollowUp[]
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?

  @@index([status])
  @@index([userId])
}

/// One line item within a Bill: seats for a single holiday.
model Signup {
  id          String    @id @default(cuid())
  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      String
  holiday     Holiday   @relation(fields: [holidayId], references: [id], onDelete: Restrict)
  holidayId   String
  menSeats    Int       @default(0)
  womenSeats  Int       @default(0)
  totalAgorot Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete: set when an admin removes this line item. Excluded from all
  /// admin views, dashboard totals, and CSV exports, but kept in the database.
  deletedAt   DateTime?

  @@unique([billId, holidayId])
  @@index([holidayId])
  @@index([deletedAt])
}

/// One successful NedarimPlus charge, against exactly one of Bill / Donation /
/// Membership / PaymentLink (whichever the webhook's Avour/Comments prefix
/// resolved to). A Membership can accumulate many of these over time (one per
/// monthly Keva charge); the others normally get just one.
model Transaction {
  id                   String       @id @default(cuid())
  bill                 Bill?        @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId               String?
  donation             Donation?    @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donationId           String?
  membership           Membership?  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId         String?
  paymentLink          PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  paymentLinkId        String?
  /// Unique (not just checked at the application layer) so two near-simultaneous
  /// webhook deliveries for the same NedarimPlus charge - a confirmed-possible
  /// retry pattern on timeout/5xx - can't both pass the pre-insert duplicate
  /// check and double-insert the same charge. Nullable since a charge with no
  /// TransactionId at all is still possible; Postgres allows any number of
  /// NULLs under a unique constraint, so this never blocks those.
  nedarimTransactionId String?      @unique
  confirmation         String?
  amountAgorot         Int
  /// True when NedarimPlus's own history didn't report an amount for this
  /// specific charge (confirmed to happen - their docs only promise a
  /// blank amount for a cancelled/declined one, not a guarantee for every
  /// success) and amountAgorot is our own fallback - the membership's own
  /// recurring rate - rather than a real reported figure. Never true for a
  /// webhook-sourced charge, which always carries a real reported Amount.
  amountIsEstimated    Boolean      @default(false)
  source               String       @default("webhook")
  rawPayload           Json?
  receivedAt           DateTime     @default(now())

  @@index([billId])
  @@index([donationId])
  @@index([membershipId])
  @@index([paymentLinkId])
}

/// A one-time donation of any amount, paid via a NedarimPlus direct link (same
/// "locked amount, redirect, webhook" pattern as Bill).
model Donation {
  id            String            @id @default(cuid())
  referenceCode String            @unique
  fullName      String
  /// Mandatory - the one reliable way to reach a donor if their payment fails.
  email         String
  /// Not required, but always asked for - collected whenever given.
  phone         String?
  address       String?
  city          String?
  amountAgorot  Int
  purpose       String?
  status        BillStatus        @default(PENDING)
  createdBy     String            @default("public")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  transactions  Transaction[]
  followUps     PaymentFollowUp[]
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?

  @@index([status])
  @@index([userId])
}

enum MembershipTier {
  ASSOCIATE
  FULL
}

enum MembershipStatus {
  /// Signed up, but NedarimPlus's standing-order ("Keva") setup webhook hasn't
  /// arrived yet to confirm it's actually established.
  PENDING
  /// Keva established and charging normally.
  ACTIVE
  /// An expected monthly charge didn't arrive within the grace window.
  PAST_DUE
  CANCELLED
}

/// A recurring monthly membership due, charged via NedarimPlus's standing-order
/// ("Keva") mechanism rather than a single payment.
model Membership {
  id                       String            @id @default(cuid())
  referenceCode            String            @unique
  fullName                 String
  /// Mandatory - the one reliable way to reach a member if a charge fails.
  email                    String
  /// Not required, but always asked for - collected whenever given.
  phone                    String?
  address                  String?
  city                     String?
  tier                     MembershipTier
  /// Snapshot of the monthly amount at signup, so a later price change doesn't
  /// rewrite history for members who already signed up at the old rate.
  monthlyAgorot            Int
  /// True when this was imported from NedarimPlus and its standing-order
  /// listing didn't report a usable Amount at all (confirmed to happen,
  /// same unreliability as the per-charge Amount handled on Transaction) -
  /// monthlyAgorot is a placeholder (0), not a real rate. Never set for a
  /// publicly-signed-up membership, which always has a real chosen amount.
  monthlyAgorotIsEstimated Boolean           @default(false)
  /// From NedarimPlus's standing-order report (KevaSuccess/KevaTashlumim) -
  /// only ever set for memberships imported from (or re-synced against) a
  /// pre-existing NedarimPlus standing order. nedarimPaymentsRemaining null
  /// commonly means no fixed end, but NedarimPlus's own docs don't spell out
  /// the exact convention for every case - worth checking their dashboard
  /// directly for a specific standing order if this looks off.
  nedarimPaymentsMade      Int?
  nedarimPaymentsRemaining Int?
  /// Set only by a real NedarimPlus DeleteKeva/DisableKeva API call (see
  /// lib/nedarim-writes.ts) succeeding - never by anything local-only like
  /// the Cancel button. The row itself is never deleted either way -
  /// "deleted on NedarimPlus" is a fact to record, not a reason to lose the
  /// record. nedarimDisabledAt clears back to null on a successful
  /// EnableKevaNew; nedarimDeletedAt never clears (DeleteKeva is permanent
  /// on NedarimPlus's side).
  nedarimDeletedAt         DateTime?
  nedarimDisabledAt        DateTime?
  /// Set once NedarimPlus's Keva-setup webhook confirms the standing order.
  kevaId                   String?           @unique
  status                   MembershipStatus  @default(PENDING)
  nextChargeDate           DateTime?
  lastChargeAt             DateTime?
  createdBy                String            @default("public")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  transactions             Transaction[]
  followUps                PaymentFollowUp[]
  user                     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                   String?

  @@index([status])
  @@index([userId])
}

/// An admin-generated payment link for a predetermined, fixed amount - e.g. a
/// pledge, an event fee, or correcting an underpayment - so someone can just
/// pay that exact amount without filling out a public form themselves.
model PaymentLink {
  id            String            @id @default(cuid())
  referenceCode String            @unique
  label         String
  fullName      String?
  phone         String?
  email         String?
  amountAgorot  Int
  status        BillStatus        @default(PENDING)
  createdBy     String            @default("admin")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  transactions  Transaction[]
  followUps     PaymentFollowUp[]
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?

  @@index([status])
  @@index([userId])
}

enum FollowUpReason {
  /// Auto-detected: stayed PENDING past the grace window with no success webhook.
  /// NedarimPlus never tells us about a decline directly, so this is the best
  /// available signal that a payment attempt may have failed.
  STALE_PENDING
  /// Staff learned about a failure some other way (e.g. a forwarded NedarimPlus
  /// decline email) and flagged it by hand, often before the grace window above
  /// would have caught it.
  MANUAL
  /// Parsed automatically from a NedarimPlus "payment failed" notification email.
  FAILURE_EMAIL
  /// Detected automatically via NedarimPlus's standing-order reporting API
  /// (GetKevaJson's ErrorText) - memberships only, no email involved at all.
  API_DECLINE
}

enum FollowUpStatus {
  OPEN
  EMAIL_SENT
  RESOLVED
  DISMISSED
}

/// Tracks a payment that may need staff follow-up. Usually tied to exactly
/// one of Bill / Donation / Membership / PaymentLink. Resolved automatically
/// the moment a later successful Transaction comes in for that same record
/// (i.e. they retried and it went through) - staff don't have to notice that
/// by hand.
///
/// A FAILURE_EMAIL-sourced follow-up may instead be "standalone" - no FK set
/// at all - when NedarimPlus's decline email is for a standing order or link
/// our system never created (e.g. one set up directly in NedarimPlus before
/// this system existed). The external* fields carry everything needed to
/// still email that person, straight from the parsed decline notification.
model PaymentFollowUp {
  id              String         @id @default(cuid())
  bill            Bill?          @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId          String?
  donation        Donation?      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donationId      String?
  membership      Membership?    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId    String?
  paymentLink     PaymentLink?   @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  paymentLinkId   String?
  reason          FollowUpReason
  status          FollowUpStatus @default(OPEN)
  notes           String?
  emailsSentCount Int            @default(0)
  lastEmailSentAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Set only when this follow-up isn't tied to any of the FKs above (a
  /// decline on something our system never created).
  externalFullName     String?
  externalPhone        String?
  externalEmail        String?
  externalAmountAgorot Int?
  externalCategory     String?
  externalKevaId       String?

  /// Diagnostic detail from a parsed NedarimPlus decline email - kept
  /// regardless of whether this follow-up matched a known record.
  failureReason String?
  cardLast4     String?

  @@index([billId])
  @@index([donationId])
  @@index([membershipId])
  @@index([paymentLinkId])
  @@index([status])
}

/// A successful NedarimPlus transaction whose Avour/Comments (and KevaId, for
/// standing orders) didn't match anything our own system generated - e.g. a
/// pre-existing standing order set up directly in NedarimPlus's dashboard, or
/// any other payment link shared outside this app. Kept so staff have a
/// complete picture of everything coming through the Mosad, not just what our
/// own forms initiated. Never auto-deleted; purely a record-keeping ledger.
model ExternalTransaction {
  id                   String   @id @default(cuid())
  nedarimTransactionId String?  @unique
  amountAgorot         Int
  clientName           String?
  phone                String?
  email                String?
  groupe               String?
  comments             String?
  confirmation         String?
  kevaId               String?
  rawPayload           Json?
  receivedAt           DateTime @default(now())
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               String?

  @@index([receivedAt])
  @@index([userId])
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  DATE
  SINGLE_CHOICE
  MULTI_CHOICE
  MULTI_TEXT
  NAME_DATE_LIST
}

/// A dynamic, admin-built form. Never listed publicly - reachable only via its
/// direct /forms/<slug> link (shared out-of-band) or the admin portal, and gated
/// by isOpen so the link itself does nothing until explicitly published.
model Form {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  description     String?
  thankYouMessage String?
  isOpen          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fields          FormField[]
  responses       FormResponse[]
}

enum FieldConditionMode {
  SHOW_IF
  HIDE_IF
}

model FormField {
  id         String        @id @default(cuid())
  form       Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId     String
  label      String
  type       FormFieldType
  required   Boolean       @default(false)
  /// string[] for SINGLE_CHOICE / MULTI_CHOICE
  options    Json?
  helpText   String?
  order      Int
  /// Soft-removed from the builder/public form, but kept so older responses
  /// that reference this field's id (in FormResponse.answers) stay resolvable.
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  /// Conditional logic, evaluated against another (earlier) field's answer:
  /// - conditionFieldId/conditionValue: which field + which answer value triggers it
  /// - conditionMode: if set, controls this field's visibility (SHOW_IF/HIDE_IF match)
  /// - altLabel: if set, replaces `label` whenever the condition value matches,
  ///   independent of conditionMode (lets a field stay always-visible but change
  ///   its wording based on an earlier answer, e.g. "Husband's Name" -> "Your Name")
  conditionFieldId String?
  conditionValue   String?
  conditionMode    FieldConditionMode?
  altLabel         String?

  @@index([formId])
}

model FormResponse {
  id        String    @id @default(cuid())
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  /// { [fieldId]: string | string[] | { name: string; date: string }[] }
  answers   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?

  @@index([formId])
  @@index([deletedAt])
  @@index([userId])
}

/// Every admin-initiated change to a payment-shaped record (override,
/// cancel, reactivate, mark paid, signup correction) - who did it, when,
/// and exactly what changed. Nothing here is ever edited or deleted after
/// the fact; it's a one-way trail, not a system of record itself. A
/// "system"-attributed entry means the webhook logged it, not an admin
/// (e.g. NedarimPlus charging a membership that's marked Cancelled here -
/// see the webhook handler).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  recordType String
  recordId   String
  /// { [field]: { before, after } }
  changes    Json
  createdAt  DateTime @default(now())

  @@index([recordType, recordId])
  @@index([createdAt])
}

model SiteSettings {
  id             Int     @id @default(1)
  aboutEn        String
  aboutHe        String
  contactPhone   String
  contactEmail   String
  address        String
  serviceTimesEn String?
  serviceTimesHe String?
  heroTaglineEn  String
  heroTaglineHe  String
}
